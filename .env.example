# Base de datos
DB_NAME=tucancha
DB_USER=root
DB_PASSWORD=root

# JWT (usa uno aleatorio largo en producción)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-de-al-menos-32-bytes-1234567890
JWT_EXPIRATION_MS=86400000

# Google OAuth2 (conseguilos en https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret

# Frontend / OAuth2
OAUTH2_REDIRECT_URI=http://localhost/oauth2/redirect
CORS_ORIGINS=http://localhost,http://localhost:5173

# MercadoPago (conseguilos en https://www.mercadopago.com.ar/developers/panel)
MP_ACCESS_TOKEN=TEST-XXXXXXXXXXXX
MP_PUBLIC_KEY=TEST-XXXXXXXXXXXX
MP_WEBHOOK_URL=http://localhost:8080/api/pagos/webhook
MP_WEBHOOK_SECRET=demo-secret
MP_WEBHOOK_VALIDATE=false

# Email (Gmail SMTP) - para enviar el código de retiro al confirmar la seña
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu-app-password-de-gmail
MAIL_FROM=tu-correo@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_DEBUG=false
